# Copy this file to .env and fill in your local values:  cp .env.example .env
# .env is gitignored - never commit it.

DB_USERNAME=postgres
DB_PASSWORD=

# Only needed if your DB isn't at the default location/name:
#DB_URL=jdbc:postgresql://localhost:5432/LibAssist

# Any 32+ character string; only matters once this is deployed somewhere real:
#JWT_SECRET=
